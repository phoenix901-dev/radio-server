#!/bin/bash
#Использовать после создания пользователя на сервере и загрузки  файлов.
#Измените скрипт, если получаете ошибку при установке разрешений.
#Пример скрипта основан на пользователе radio группе radio.
set -e
chown -R radio:radio /home/radio
# u=rwX,go=rX: каталоги получают +x, а обычные файлы остаются неисполняемыми.
# Прежний "chmod 755 -R" делал исполняемыми вообще все файлы, включая музыку.
chmod -R u=rwX,go=rX /home/radio
echo "permissions fixed successfully"